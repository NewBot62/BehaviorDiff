{
  "name": "behaviordiff",
  "version": "0.0.1",
  "description": "Behavioral diff for TypeScript/JavaScript changes: run the old and new version on generated inputs and report what changed in behavior, not in text.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "behaviordiff": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "action.yml",
    "scripts/pr-review.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "bench": "npm run build && node dist/bench/run.js && node dist/bench/run.js --suite=hard",
    "bench:llm": "npm run build && node dist/bench/llm.js",
    "bench:leaderboard": "npm run build && node dist/bench/leaderboard.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewBot62/BehaviorDiff.git"
  },
  "homepage": "https://github.com/NewBot62/BehaviorDiff#readme",
  "bugs": {
    "url": "https://github.com/NewBot62/BehaviorDiff/issues"
  },
  "keywords": [
    "behavioral-diff",
    "differential-testing",
    "code-review",
    "ai-generated-code",
    "typescript",
    "javascript"
  ]
}
